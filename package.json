{
	"name": "@sfgartland/better-pi-voice",
	"version": "0.1.0",
	"description": "Streaming voice input for pi: Deepgram (nova-3, repo-aware keyterms) or local Parakeet, with Claude-Code-style recovery so speech is never lost.",
	"license": "MIT",
	"author": "Severin Gartland <sfgartland@hotmail.com>",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sfgartland/better-pi-voice.git"
	},
	"homepage": "https://github.com/sfgartland/better-pi-voice#readme",
	"bugs": {
		"url": "https://github.com/sfgartland/better-pi-voice/issues"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"voice",
		"dictation",
		"speech-to-text",
		"deepgram",
		"parakeet",
		"hold-to-talk",
		"keyterms",
		"coding-agent",
		"cli"
	],
	"files": [
		"index.ts",
		"src/",
		"!src/**/*.test.ts",
		"!src/testing/",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"optionalDependencies": {
		"transcribe-cpp": "^0.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@earendil-works/pi-ai": "^1.0.1",
		"@earendil-works/pi-coding-agent": "^1.0.1",
		"@earendil-works/pi-tui": "^1.0.1",
		"@types/bun": "^1.3.14",
		"typescript": "^7.0.2"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		],
		"image": "https://raw.githubusercontent.com/sfgartland/better-pi-voice/main/media/screenshot.png",
		"video": "https://raw.githubusercontent.com/sfgartland/better-pi-voice/main/media/demo.mp4"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "bun test",
		"check": "npm run typecheck && npm run lint && npm test"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
